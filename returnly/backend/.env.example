PORT=3002
# Secreto para firmar las sesiones (mínimo 32 caracteres, cualquier texto largo al azar)
SESSION_SECRET=cambiar-por-un-texto-largo-al-azar-de-32-o-mas
# Supabase (empresas, usuarios y accesos). La clave SECRETA está en Project Settings -> API Keys -> Secret keys.
SUPABASE_URL=https://zxwudwagkowbxaonzaoh.supabase.co
SUPABASE_SECRET_KEY=
# Clave para encriptar las KEY de Google de las empresas: 64 caracteres hex. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, hay que volver a cargar las KEY de todas las empresas desde el admin.
CREDENCIALES_KEY=
# IA para el feedback (Gemini, nivel gratuito). Sacala en https://aistudio.google.com -> Get API key.
# Si queda vacía, el panel muestra las recomendaciones de siempre, sin IA.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto, el Flash más nuevo)
# GEMINI_MODEL=gemini-flash-latest
